# Environment: Development
# Description: This file contains the environment variables for the development environment.
# Note: In real scenarios, this file is not committed to the repository.

# VITE_PRIME_UI_LICENSE_KEY is the license key for the Prime UI library.
VITE_PRIME_UI_LICENSE_KEY=your_prime_license

VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT_MS=15000

# --- Bounded Context endpoint prefixes (BC01 – BC12) ---
VITE_API_BC01_CATALOG=/catalog
VITE_API_BC02_SENSORY=/sensory
VITE_API_BC03_SCHEDULING=/scheduling
VITE_API_BC04_READINESS=/readiness
VITE_API_BC05_TICKETING=/ticketing
VITE_API_BC06_SEATS=/seats
VITE_API_BC07_EXECUTION=/execution
VITE_API_BC08_EMERGENCY=/emergency
VITE_API_BC09_CALIBRATION=/calibration
VITE_API_BC10_MAINTENANCE=/maintenance
VITE_API_BC11_ANALYTICS=/analytics
VITE_API_BC12_SUBSCRIPTIONS=/subscriptions

# --- BC01 – Movie & Sensory Content Management ---
VITE_MOVIES_ENDPOINT_PATH=/catalog/movies
VITE_GENRES_ENDPOINT_PATH=/catalog/genres
VITE_SENSORY_FILES_ENDPOINT_PATH=/catalog/sensoryFiles
VITE_SENSORY_TRACKS_ENDPOINT_PATH=/catalog/sensoryTracks
VITE_CONFIGURATION_HISTORY_ENDPOINT_PATH=/catalog/configurationHistory

# --- BC02 – Scheduling & Calendar ---
VITE_SHOWS_ENDPOINT_PATH=/scheduling/shows
VITE_SCHEDULE_CONFLICTS_ENDPOINT_PATH=/scheduling/scheduleConflicts

# --- BC03 – Room & Resource Readiness ---
VITE_ROOMS_ENDPOINT_PATH=/readiness/rooms
VITE_ROOM_INSPECTIONS_ENDPOINT_PATH=/readiness/roomInspections
VITE_ROOM_BLOCKS_ENDPOINT_PATH=/readiness/maintenanceBlocks
VITE_RESOURCE_CALCULATIONS_ENDPOINT_PATH=/readiness/resourceCalculations

#--- BC04 – Ticketing & Reservations ---
VITE_TICKETING_INTEGRATIONS_ENDPOINT_PATH=/ticketingIntegrations
VITE_SYNC_LOGS_ENDPOINT_PATH=/syncLogs
VITE_SHOW_OCCUPANCIES_ENDPOINT_PATH=/showOccupancies